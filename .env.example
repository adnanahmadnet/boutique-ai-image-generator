# --- PayPal Sandbox --------------------------------------------------------
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-sandbox-client-id
# Optional override — defaults to the Sandbox API base in lib/paypal.ts.
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id from PayPal Developer Dashboard → your app → Webhooks (point the
# webhook at <your-site>/api/webhooks/paypal, subscribed to at least
# PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED).
PAYPAL_WEBHOOK_ID=your-webhook-id

# --- Database (local Postgres) ----------------------------------------------
# A dedicated role + database for this app. See db/migrations/0001_init.sql
# (and later files in db/migrations/) for the schema — apply each in order:
#   psql -U <role> -h localhost -d <database> -f db/migrations/0001_init.sql
#   psql -U <role> -h localhost -d <database> -f db/migrations/0002_add_is_admin.sql
#   psql -U <role> -h localhost -d <database> -f db/migrations/0003_separate_admin_table.sql
DATABASE_URL=postgresql://boutique_ai_app:your-password@localhost:5432/boutique_ai

# There is no ADMIN_EMAILS / signup bootstrap — admin is a fully separate
# identity (public.admins, capped at exactly one row) from buyer accounts
# (public.users). The public /signup form can never create one. Create or
# rotate the single admin record with:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD=... node db/seed-admin.mjs
# Then log in at the normal /login with that email and password — the login
# route checks the admins table first and sends you to /admin automatically.

# --- Transactional email (Resend) -----------------------------------------
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=orders@yourdomain.com
# Where /api/contact submissions get forwarded — not fabricated, confirm the
# real support inbox before launch (see plan §14).
CONTACT_INBOX_EMAIL=support@yourdomain.com

# --- Misc --------------------------------------------------------------------
# Used to build absolute links in emails/webhook responses. Set to the real
# deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "false" to disable rate limiting during local development.
# RATE_LIMIT_ENABLED=true
